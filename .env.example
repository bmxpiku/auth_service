DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/auth_db"

# RSA private key (PKCS8 PEM, base64-encoded) used to sign/verify access
# tokens. Required in production; safe to leave unset in development/test
# (an ephemeral keypair is generated in-memory instead, invalidated on
# every restart).
#
# DO NOT put a real key value in this file — .env.example is committed to
# git and is meant purely as a template. Generate your OWN key locally and
# put it in your untracked .env file instead:
#   npx tsx scripts/generate-jwt-key.ts
JWT_PRIVATE_KEY_BASE64=
